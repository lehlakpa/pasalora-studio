PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Set true behind HTTPS in production; false for localhost HTTP.
COOKIE_SECURE=false
# eSewa ePay v2: use merchant-issued credentials. Never expose the secret to the frontend.
ESEWA_MODE=sandbox
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# Public origin serving the frontend and /api proxy (must match your callback domain).
PUBLIC_APP_URL=http://localhost:5173
# Token lifetime: positive seconds or s/m/h/d/w suffixes.
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
